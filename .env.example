MONGODB_URI=mongodb://127.0.0.1:27017/certitube
JWT_SECRET=replace-with-at-least-32-random-characters
YOUTUBE_API_KEY=
APP_URL=https://certitube.vercel.app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
ADMIN_ID=
ADMIN_PASSWORD=
# Set to true to turn certificate issuing, downloads, and review back on.
CERTIFICATES_ENABLED=
